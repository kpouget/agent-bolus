[Unit]
Description=Diabetes NOOA Bolus Review
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/kpouget/vayrac/git/agent-bolus
ExecStart=/usr/bin/uv run scripts/nooa_bolus_review.py

# Logging
StandardOutput=journal
StandardError=journal

# Security and resource limits
PrivateNetwork=false
MemoryMax=2G
TimeoutSec=1800
Restart=no

# Environment file (optional - loads .env if present)
EnvironmentFile=-/home/kpouget/vayrac/git/agent-bolus/.env

[Install]
WantedBy=default.target